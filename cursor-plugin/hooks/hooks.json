{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" sessionStart",
        "timeout": 3
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" sessionEnd",
        "timeout": 3
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" beforeSubmitPrompt",
        "timeout": 3
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" preToolUse",
        "timeout": 3
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" postToolUse",
        "timeout": 3
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" postToolUseFailure",
        "timeout": 3
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/hook.cjs\" stop",
        "timeout": 3
      }
    ]
  }
}
