[Unit]
Description=LingPet Market
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lingpet
Group=lingpet
WorkingDirectory=/opt/lingpet-market
EnvironmentFile=/etc/lingpet-market.env
Environment=GOMAXPROCS=1 GOMEMLIMIT=384MiB
ExecStart=/opt/lingpet-market/lingpet-market
Restart=on-failure
RestartSec=5
StateDirectory=lingpet-market
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lingpet-market
CPUQuota=50%
Nice=10
MemoryHigh=512M
MemoryMax=768M
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
