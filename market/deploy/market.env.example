LINGPET_LISTEN=127.0.0.1:9633
LINGPET_PUBLIC_URL=https://lingpet.fourzkw.top
LINGPET_DATA_DIR=/var/lib/lingpet-market
LINGPET_DOWNLOAD_DIR=/opt/lingpet-market/downloads
# First initialization only. Saved credentials take precedence on later starts.
LINGPET_ADMIN_USER=admin
# Optional: seed an existing password hash on first initialization.
# If omitted, a unique initial password is generated in the private data directory.
# LINGPET_ADMIN_PASSWORD_HASH=
# Optional server-side GitHub token for public API rate limits.
# GITHUB_TOKEN=
LINGPET_DEV_MODE=false


# GitHub public API routes, tried in order; defaults work without a local proxy.
# Use direct alone to disable third-party gateways. Tokens are sent only to direct GitHub.
LINGPET_GITHUB_ROUTES=direct,gh-proxy,ghfast
